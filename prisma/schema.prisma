generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum Complexity {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          Role      @default(USER)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())

  accounts    Account[]
  sessions    Session[]
  prompts     Prompt[]        @relation("PromptAuthor")
  versions    PromptVersion[] @relation("VersionAuthor")
  favorites   Favorite[]
  usageEvents UsageEvent[]
  reviewed    PromptVersion[] @relation("VersionReviewer")
  auditLogs   AdminAuditLog[] @relation("AuditActor")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Category {
  id      String   @id @default(cuid())
  name    String   @unique
  prompts Prompt[]
}

model Prompt {
  id          String     @id @default(cuid())
  title       String
  currentBody String     @db.Text
  variables   String[]   @default([])
  complexity  Complexity @default(BEGINNER)
  useCount    Int        @default(0)
  isPublished Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  authorId   String
  author     User      @relation("PromptAuthor", fields: [authorId], references: [id])
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  versions    PromptVersion[]
  favorites   Favorite[]
  usageEvents UsageEvent[]

  @@index([categoryId])
  @@index([complexity])
  @@index([authorId])
  @@index([isPublished, updatedAt])
}

model PromptVersion {
  id         String           @id @default(cuid())
  promptId   String
  prompt     Prompt           @relation(fields: [promptId], references: [id], onDelete: Cascade)
  body       String           @db.Text
  variables  String[]         @default([])
  complexity Complexity       @default(BEGINNER)
  status     SubmissionStatus @default(PENDING)
  note       String?

  authorId String
  author   User   @relation("VersionAuthor", fields: [authorId], references: [id])

  reviewerId   String?
  reviewer     User?     @relation("VersionReviewer", fields: [reviewerId], references: [id])
  reviewedAt   DateTime?
  rejectReason String?

  createdAt DateTime @default(now())

  @@index([promptId, status])
  @@index([status, createdAt])
}

model Favorite {
  userId    String
  promptId  String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  prompt    Prompt   @relation(fields: [promptId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, promptId])
  @@index([promptId])
}

enum UsageEventType {
  VIEW
  COPY
  SEARCH_NO_RESULT
}

model UsageEvent {
  id        String         @id @default(cuid())
  type      UsageEventType
  userId    String?
  user      User?          @relation(fields: [userId], references: [id])
  promptId  String?
  prompt    Prompt?        @relation(fields: [promptId], references: [id])
  query     String?
  createdAt DateTime       @default(now())

  @@index([type, createdAt])
  @@index([promptId])
  @@index([userId])
}

enum AuditAction {
  ROLE_CHANGED
  USER_ACTIVATED
  USER_DEACTIVATED
  SUBMISSION_APPROVED
  SUBMISSION_REJECTED
}

/// Append-only record of admin actions, for accountability (who promoted/
/// deactivated whom, who approved/rejected what, and when).
model AdminAuditLog {
  id         String      @id @default(cuid())
  action     AuditAction
  actorId    String
  actor      User        @relation("AuditActor", fields: [actorId], references: [id])
  targetType String
  targetId   String
  detail     String?
  createdAt  DateTime    @default(now())

  @@index([targetType, targetId])
  @@index([createdAt])
}
